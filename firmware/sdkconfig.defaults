# Target chip
CONFIG_IDF_TARGET="esp32c3"

# Partition table
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_OFFSET=0x8000

# Flash size configuration (4MB)
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="4MB"

# Web server WebSocket support (required for /ws endpoint and live logs)
CONFIG_HTTPD_WS_SUPPORT=y

# FreeRTOS configuration
CONFIG_FREERTOS_HZ=1000

# Sockets: balanced for HTTP, WebSocket, MQTT, and GVRET on ESP32-C3
CONFIG_LWIP_MAX_SOCKETS=10

# Wi-Fi buffer tuning: balanced for ESP32-C3
CONFIG_ESP32_WIFI_DYNAMIC_RX_BUFFER_NUM=16
CONFIG_ESP32_WIFI_DYNAMIC_TX_BUFFER_NUM=32
CONFIG_ESP32_WIFI_STATIC_RX_BUFFER_NUM=6

# Main boot task stack headroom for catalog parsing
CONFIG_ESP_MAIN_TASK_STACK_SIZE=6144

# System event task stack size
CONFIG_ESP_SYSTEM_EVENT_TASK_STACK_SIZE=3584

# Compiler optimization for code size
CONFIG_COMPILER_OPTIMIZATION_SIZE=y

# Default DHCP and network hostname (can-do)
CONFIG_LWIP_LOCAL_HOSTNAME="can-do"

# Native Bluetooth Low Energy (BLE) & NimBLE Configuration
# CONFIG_BT_ENABLED is not set



